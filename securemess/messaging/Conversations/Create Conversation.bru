meta {
  name: Create Conversation
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/conversations/
  body: json
  auth: inherit
}

body:json {
  [
      "{{SenderUuid}}",
      "{{ReceiverUuid}}"
    ]
  
}

vars:pre-request {
  SenderUuid: {{createdUserUuid}}
  ReceiverUuid: 94546601-ffd1-49bf-ae8e-51941343805f
}

script:post-response {
  if (res.getStatus() === 200 || res.getStatus() === 201) {
    const body = res.getBody();
    bru.setEnvVar("conversationId", body.id);
  }
}
